{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:intryc:ticket:1.0",
  "title": "Intryc bulk ticket 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_ticket_id", "created_at", "updated_at", "users"],
  "properties": {
    "schema_version": {"const": "ticket/1.0"},
    "source_ticket_id": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 512},
    "subject": {"$ref": "#/$defs/optionalString"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "source": {"$ref": "#/$defs/optionalString"},
    "status": {"$ref": "#/$defs/optionalString"},
    "priority": {"$ref": "#/$defs/optionalString"},
    "group": {"$ref": "#/$defs/optionalString"},
    "rating": {"$ref": "#/$defs/optionalString"},
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
    },
    "custom_fields": {"$ref": "#/$defs/scalarMap"},
    "users": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/user"}
    },
    "assignee_source_user_id": {"$ref": "#/$defs/userReference"},
    "requester_source_user_id": {"$ref": "#/$defs/userReference"},
    "comments": {
      "type": "array",
      "items": {"$ref": "#/$defs/comment"}
    },
    "calls": {
      "type": "array",
      "items": {"$ref": "#/$defs/call"}
    },
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/generalEvent"}
    },
    "field_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/fieldEvent"}
    },
    "tag_events": {
      "type": "array",
      "items": {"$ref": "#/$defs/tagEvent"}
    }
  },
  "$defs": {
    "optionalString": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S", "maxLength": 1024},
    "scalar": {"type": ["string", "number", "boolean", "null"]},
    "scalarMap": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1, "pattern": "\\S"},
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "flexibleMap": {"type": "object", "additionalProperties": true},
    "role": {"enum": ["user", "agent", "admin", "bot", "system"]},
    "userReference": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 512},
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_user_id", "role"],
      "properties": {
        "source_user_id": {"$ref": "#/$defs/userReference"},
        "name": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 1024},
        "email": {"type": "string", "format": "email"},
        "role": {"$ref": "#/$defs/role"},
        "active": {"type": "boolean"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "custom_fields": {"$ref": "#/$defs/scalarMap"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])"},
    "safeFileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!\\.\\.?$)[^/\\\\\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "assetPath": {
      "type": "string",
      "pattern": "^assets/(?:(?!\\.\\.?(?:/|$))[^/\\\\*?\\[\\]\\u0000-\\u001f\\u007f]+/)*(?!\\.\\.?(?:/|$))[^/\\\\*?\\[\\]\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "contentType": {
      "enum": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "audio/flac",
        "audio/mp4",
        "audio/mpeg",
        "audio/ogg",
        "audio/wav",
        "audio/x-wav",
        "image/gif",
        "image/jpeg",
        "image/png",
        "image/webp",
        "text/csv",
        "text/plain",
        "video/mp4"
      ]
    },
    "attachmentContentType": {
      "enum": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "image/gif",
        "image/jpeg",
        "image/png",
        "image/webp",
        "text/csv",
        "text/plain"
      ]
    },
    "audioContentType": {
      "enum": [
        "audio/flac",
        "audio/mp4",
        "audio/mpeg",
        "audio/ogg",
        "audio/wav",
        "audio/x-wav",
        "video/mp4"
      ]
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_attachment_id", "path", "file_name", "content_type", "bytes", "sha256"],
      "properties": {
        "source_attachment_id": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 512},
        "path": {"$ref": "#/$defs/assetPath"},
        "file_name": {"$ref": "#/$defs/safeFileName"},
        "content_type": {"$ref": "#/$defs/attachmentContentType"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 26214400},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_name", "content_type", "bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/assetPath"},
        "file_name": {"$ref": "#/$defs/safeFileName"},
        "content_type": {"$ref": "#/$defs/audioContentType"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "content"],
      "properties": {
        "format": {"enum": ["plain_text", "html"]},
        "content": {"type": "string"}
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_comment_id", "created_at", "type", "author_source_user_id"],
      "anyOf": [{"required": ["body"]}, {"required": ["attachments"], "properties": {"attachments": {"minItems": 1}}}],
      "properties": {
        "source_comment_id": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 512},
        "created_at": {"type": "string", "format": "date-time"},
        "type": {"enum": ["message", "note"]},
        "source": {"$ref": "#/$defs/optionalString"},
        "body": {"$ref": "#/$defs/body"},
        "author_source_user_id": {"$ref": "#/$defs/userReference"},
        "attachments": {"type": "array", "items": {"$ref": "#/$defs/attachment"}}
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_call_id", "created_at", "media"],
      "properties": {
        "source_call_id": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 512},
        "created_at": {"type": "string", "format": "date-time"},
        "source": {"$ref": "#/$defs/optionalString"},
        "direction": {"enum": ["inbound", "outbound"]},
        "fields": {"$ref": "#/$defs/flexibleMap"},
        "media": {"$ref": "#/$defs/media"}
      }
    },
    "eventBase": {
      "type": "object",
      "required": ["source_event_id", "created_at", "type"],
      "properties": {
        "source_event_id": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 512},
        "created_at": {"type": "string", "format": "date-time"},
        "fields": {"$ref": "#/$defs/flexibleMap"},
        "actor_source_user_id": {"$ref": "#/$defs/userReference"}
      }
    },
    "generalEvent": {
      "allOf": [
        {"$ref": "#/$defs/eventBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_event_id": true,
            "created_at": true,
            "fields": true,
            "actor_source_user_id": true,
            "type": {
              "enum": [
                "assigned",
                "created",
                "custom",
                "group_changed",
                "priority_changed",
                "requester_changed",
                "status_changed",
                "unassigned",
                "updated"
              ]
            }
          }
        }
      ]
    },
    "fieldEvent": {
      "allOf": [
        {"$ref": "#/$defs/eventBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field_name"],
          "properties": {
            "source_event_id": true,
            "created_at": true,
            "actor_source_user_id": true,
            "type": {"enum": ["change", "update", "add", "remove"]},
            "field_name": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 512},
            "previous_value": {"$ref": "#/$defs/scalar"},
            "value": {"$ref": "#/$defs/scalar"}
          }
        }
      ]
    },
    "tagEvent": {
      "allOf": [
        {"$ref": "#/$defs/eventBase"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_event_id": true,
            "created_at": true,
            "actor_source_user_id": true,
            "type": {"enum": ["change", "update", "add", "remove"]},
            "previous_value": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
            "value": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
          }
        }
      ]
    }
  }
}
